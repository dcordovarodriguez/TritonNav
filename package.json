{
  "name": "triton-nav",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack --disable-source-maps",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "check:campus-gis": "node scripts/check-campus-gis-import.mjs",
    "campus-data:fetch:buildings": "node scripts/campus-data/fetch-ucsd-buildings.mjs",
    "campus-data:fetch:classrooms": "node scripts/campus-data/fetch-ucsd-classrooms.mjs",
    "campus-data:fetch:media": "node scripts/campus-data/fetch-ucsd-classroom-media.mjs",
    "campus-data:normalize:buildings": "node scripts/campus-data/normalize-ucsd-buildings.mjs",
    "campus-data:normalize:classrooms": "node scripts/campus-data/normalize-ucsd-classrooms.mjs",
    "campus-data:reconcile": "node scripts/campus-data/reconcile-building-room-links.mjs",
    "campus-data:compare": "node scripts/campus-data/compare-campus-data.mjs",
    "campus-data:validate": "node scripts/campus-data/validate-campus-data.mjs",
    "campus-data:audit": "npm run campus-data:fetch:buildings && npm run campus-data:fetch:classrooms && npm run campus-data:fetch:media && npm run campus-data:normalize:buildings && npm run campus-data:normalize:classrooms && npm run campus-data:reconcile && npm run campus-data:compare && npm run campus-data:validate",
    "check:indoor-data": "node scripts/check-indoor-data.mjs",
    "check:production-routing": "node scripts/check-production-routing.mjs",
    "check:valhalla": "node scripts/check-valhalla-health.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "next lint",
    "cap:init": "npx cap init TritonNav net.diegocordova.tritonnav --web-dir=out",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:copy": "npx cap copy",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "maplibre-gl": "^6.0.0",
    "next": "^16.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
