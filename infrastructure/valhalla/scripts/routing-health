#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/lib.sh"

load_env
require_env VALHALLA_API_PORT

BASE_URL="${VALHALLA_BASE_URL:-http://localhost:${VALHALLA_API_PORT}}"
STATUS_URL="${BASE_URL%/}/status"

require_command curl

info "Checking Valhalla health endpoint: ${STATUS_URL}"
curl --fail --silent --show-error --max-time 5 "${STATUS_URL}" >/dev/null || error "Valhalla health endpoint did not respond at ${STATUS_URL}."
info "Valhalla health endpoint responded successfully."
