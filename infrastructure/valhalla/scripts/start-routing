#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/lib.sh"

validate_common
require_osm_file
require_port_available
require_image_manifest

cd "${VALHALLA_DIR}"

info "Starting TritonNav Valhalla routing service..."
info "Image: ${VALHALLA_IMAGE}"
info "Platform: ${VALHALLA_PLATFORM}"
info "Port: ${VALHALLA_API_PORT}:8002"

docker compose --profile routing up -d --pull never
