# TritonNav local Valhalla proof-of-concept template.
# Copy to infrastructure/valhalla/.env when ready.
#
# Do not commit infrastructure/valhalla/.env.

# Recommended upstream image for Apple Silicon POC.
# Verify arm64 support before pulling:
#   docker buildx imagetools inspect ghcr.io/valhalla/valhalla-scripted:latest
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
VALHALLA_PLATFORM=linux/arm64

# Local API port exposed on the Mac.
VALHALLA_API_PORT=8002

# UCSD-only extract placeholder. The file must be placed in ./osm before start.
VALHALLA_OSM_FILENAME=ucsd-campus.osm.pbf

# Persistent bind-mount directories under infrastructure/valhalla.
VALHALLA_OSM_DIR=./osm
VALHALLA_TILE_DIR=./tiles
VALHALLA_CONFIG_DIR=./config
VALHALLA_LOG_DIR=./logs
VALHALLA_CUSTOM_FILES_DIR=./custom_files

# Conservative local defaults for a Mac with about 3.8 GiB Docker memory.
VALHALLA_SERVER_THREADS=2
VALHALLA_USE_TILES_IGNORE_PBF=False
VALHALLA_FORCE_REBUILD=False
VALHALLA_BUILD_ELEVATION=False
VALHALLA_BUILD_ADMINS=False
VALHALLA_BUILD_TIME_ZONES=False
VALHALLA_BUILD_TAR=True
VALHALLA_SERVE_TILES=True
VALHALLA_TILESET_NAME=ucsd_valhalla_tiles
VALHALLA_PATH_EXTENSION=

VALHALLA_COMPOSE_PROJECT_NAME=tritonnav-routing
VALHALLA_CONTAINER_NAME=tritonnav-valhalla
